DATABASE_URI=postgresql://postgres:postgres@localhost:5432/ipt
PAYLOAD_SECRET=replace-with-a-random-secret-of-at-least-32-characters
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Populate only with verified company details.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP=
# Online checkout (server-side only; never prefix the server key with NEXT_PUBLIC).
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
# Set real IDR prices, e.g. {"instax-sq40":YOUR_INTEGER_PRICE,...}.
# Leave empty until confirmed; no guessed prices are used.
# Product slugs: instax-sq40, instax-wide-400, instax-wide-400-green,
# instax-mini-pink-lemonade, instax-square-black-frame, instax-wide-twin-pack, quicksnap,
# gigabyte-graphic-card.
PRODUCT_PRICES_IDR=
# Set an integer IDR delivery fee. Use 0 only for deliberately free shipping.
SHIPPING_FEE_IDR=
